# Copy this file to .env and fill in the keys you have. All values are read
# once, in one place, by config.js -- nothing else in the app reads
# process.env directly.

# PostgreSQL connection string -- required.
# For local dev: postgres://localhost/card_scanner  (or a Neon connection string)
# For Render: set this in the Render dashboard; Neon free tier works great.
DATABASE_URL=

# Apollo.io API key -- Settings -> Integrations -> API in your Apollo account.
# Enables: card enrichment (Scan Business Card) + lead search (Find Leads)
APOLLO_API_KEY=

# ── AI models ────────────────────────────────────────────────────────────
# Two workloads, two providers, configured independently:
#
#   Email drafting / classification -> OpenAI GPT-5.6 Luna  (cheap, high volume)
#   Account & company research      -> Claude               (needs Anthropic's
#                                                            server-side web search)
#
# Anthropic (Claude) API key -- console.anthropic.com
# REQUIRED for Account Research and company research. Also serves as the
# fallback for email drafting when OPENAI_API_KEY is absent or OpenAI errors.
CLAUDE_API_KEY=

# OpenAI API key -- platform.openai.com. Offers GPT as a premium drafting option.
OPENAI_API_KEY=

# Bailian (Qwen) -- the DEFAULT email drafting model, via its OpenAI-compatible
# endpoint. All three are required together; with any missing, Qwen is simply
# not offered and drafting uses the next configured provider.
# BAILIAN_BASE_URL has no built-in default on purpose: this deployment uses a
# token-plan host rather than the public one, and a hardcoded fallback could
# send the key to the wrong endpoint.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_EMAIL_MODEL=qwen3.6-flash

# Optional model overrides. Defaults shown are what the app uses if unset;
# changing one never affects the other workflow.
#   DEFAULT_EMAIL_MODEL_ID=qwen              # qwen | gpt | claude
#   EMAIL_REQUEST_TIMEOUT_MS=60000           # per-provider deadline
#   OPENAI_EMAIL_MODEL=gpt-5.6-luna          # $0.20/$1.20 per 1M in/out
#   CLAUDE_EMAIL_FALLBACK_MODEL=claude-sonnet-4-6
# GPT-5.6 is a reasoning family: the token cap covers thinking as well as the
# reply, so it is set well above the old Claude value of 1024.
#   OPENAI_EMAIL_MAX_TOKENS=4000
#   OPENAI_EMAIL_REASONING_EFFORT=low        # minimal | low | medium | high
#   OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions

# Optional login gate -- set BOTH to require an HTTP Basic Auth login for the
# whole app. Leave both blank to leave the app open (default, local dev).
APP_USERNAME=
APP_PASSWORD=

# Optional: change the port the server listens on (default 3000)
PORT=

# MapYourShow 展商目录（update_show_data.py / probe_booth_fields.py 用）
# 会话 Cookie，会过期。DevTools → Network → 任一 exh-remote-proxy 请求 → 复制 Cookie 头
MYS_COOKIE=
# 可选，留空即直连（实测无需代理）
MYS_PROXY=

# ── Tests ─────────────────────────────────────────────────────────────────────
# The database `npm test` is allowed to touch. There is deliberately NO fallback
# to DATABASE_URL: without this set, database-backed suites skip rather than
# quietly writing to production. Point it at a scratch database — a Neon branch,
# a local Postgres, or a PGlite socket. It must not name the same host and
# database as DATABASE_URL; the guard refuses to run if it does.
TEST_DATABASE_URL=

# Standalone Account Research app (Qwen-based), embedded in the Account Research
# page as an iframe. Its own service: own models, retrieval, Apollo, credentials
# and storage. Nothing is shared with this CRM but the iframe.
#   local:      http://127.0.0.1:5057
#   production: https://<render-service>.onrender.com
# Leave empty and the Current tab explains that it is not configured.
CURRENT_ACCOUNT_RESEARCH_URL=
