# Copy this file to .env and fill in the keys you have. All values are read
# once, in one place, by config.js -- nothing else in the app reads
# process.env directly.

# PostgreSQL connection string -- required.
# For local dev: postgres://localhost/card_scanner  (or a Neon connection string)
# For Render: set this in the Render dashboard; Neon free tier works great.
DATABASE_URL=

# Apollo.io API key -- Settings -> Integrations -> API in your Apollo account.
# Enables: card enrichment (Scan Business Card) + lead search (Find Leads)
APOLLO_API_KEY=

# Anthropic (Claude) API key -- console.anthropic.com
# Enables: AI-drafted outreach emails (without it, drafting returns a template stub)
CLAUDE_API_KEY=

# Optional login gate -- set BOTH to require an HTTP Basic Auth login for the
# whole app. Leave both blank to leave the app open (default, local dev).
APP_USERNAME=
APP_PASSWORD=

# Optional: change the port the server listens on (default 3000)
PORT=

# MapYourShow 展商目录（update_show_data.py / probe_booth_fields.py 用）
# 会话 Cookie，会过期。DevTools → Network → 任一 exh-remote-proxy 请求 → 复制 Cookie 头
MYS_COOKIE=
# 可选，留空即直连（实测无需代理）
MYS_PROXY=
